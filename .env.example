# Playwright: chrome = системный Chrome (локально); пусто = bundled Chromium (Docker)
BROWSER_CHANNEL=chrome

# Замените [YOUR-PASSWORD] на пароль из Supabase → Project Settings → Database
DATABASE_URL=postgresql://postgres.pwhcszhjulfjdndxbzkx:[YOUR-PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# Прокси (через запятую): http://user:pass@host:port,socks5://host:port
PROXY_LIST=
PROXY_USE_DIRECT=true

# Apify fallback после 5 подряд неудачных раундов (все прокси + direct)
APIFY_API_TOKEN=
APIFY_FALLBACK_THRESHOLD=5
APIFY_GOOGLE_ACTOR=apify/google-search-scraper
APIFY_YANDEX_ACTOR=johnvc/Scrape-Yandex
APIFY_YANDEX_MAPS_ACTOR=zen-studio/yandex-maps-scraper

# LLM (OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_RAW_TEXT_MAX_CHARS=4000
